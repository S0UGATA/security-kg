 model misinterpreting image content, potentially affecting the integrity of processed data."},{"subject":"CVE-2026-12491","predicate":"product","object":"vLLM","source":"cve","object_type":"string","object_canonical":"vllm"},{"subject":"CVE-2026-12491","predicate":"product","object":"Red Hat AI Inference Server","source":"cve","object_type":"string","object_canonical":"red hat ai inference server"},{"subject":"CVE-2026-12491","predicate":"product","object":"Red Hat Enterprise Linux AI (RHEL AI) 3","source":"cve","object_type":"string","object_canonical":"red hat enterprise linux ai (rhel ai) 3"},{"subject":"CVE-2026-12491","predicate":"product","object":"Red Hat OpenShift AI (RHOAI)","source":"cve","object_type":"string","object_canonical":"red hat openshift ai (rhoai)"},{"subject":"CVE-2026-12491","predicate":"rdf:type","object":"Vulnerability","source":"cve","object_type":"enum","object_canonical":"vulnerability"},{"subject":"CVE-2026-12491","predicate":"related-weakness","object":"CWE-115","source":"cve","object_type":"id","object_canonical":"CWE-115"},{"subject":"CVE-2026-12491","predicate":"state","object":"PUBLISHED","source":"cve","object_type":"enum","object_canonical":"published"},{"subject":"CVE-2026-12491","predicate":"vendor","object":"vllm-project","source":"cve","object_type":"string","object_canonical":"vllm-project"},{"subject":"CVE-2026-12491","predicate":"vendor","object":"Red Hat","source":"cve","object_type":"string","object_canonical":"red hat"},{"subject":"CVE-2025-8556","predicate":"affects-cpe","object":"cpe:/a:redhat:openshift_builds:1","source":"cve","object_type":"id","object_canonical":"cpe:/a:redhat:openshift_builds:1"},{"subject":"CVE-2025-8556","predicate":"affects-cpe","object":"cpe:/a:redhat:openshift_custom_metrics_autoscaler:2","source":"cve","object_type":"id","object_canonical":"cpe:/a:redhat:openshift_custom_metrics_autoscaler:2"},{"subject":"CVE-2025-8556","predicate":"affects-cpe","object":"cpe:/a:redhat:multicluster_globalhu