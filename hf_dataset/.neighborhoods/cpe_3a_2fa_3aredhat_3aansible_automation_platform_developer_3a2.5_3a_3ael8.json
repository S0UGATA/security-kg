rm_developer:2.6::el10"},{"subject":"CVE-2026-84486","predicate":"affects-cpe","object":"cpe:/a:redhat:ansible_automation_platform_developer:2.6::el9","source":"cve","object_type":"id","object_canonical":"cpe:/a:redhat:ansible_automation_platform_developer:2.6::el9"},{"subject":"CVE-2026-84486","predicate":"affects-cpe","object":"cpe:/a:redhat:ansible_automation_platform_inside:2.6::el9","source":"cve","object_type":"id","object_canonical":"cpe:/a:redhat:ansible_automation_platform_inside:2.6::el9"},{"subject":"CVE-2026-84486","predicate":"affects-cpe","object":"cpe:/a:redhat:ansible_automation_platform:2.7::el9","source":"cve","object_type":"id","object_canonical":"cpe:/a:redhat:ansible_automation_platform:2.7::el9"},{"subject":"CVE-2026-84486","predicate":"assigner","object":"redhat","source":"cve","object_type":"string","object_canonical":"redhat"},{"subject":"CVE-2026-84486","predicate":"cvss-base-score","object":"8.2","source":"cve","object_type":"number","object_canonical":"8.2"},{"subject":"CVE-2026-84486","predicate":"cvss-severity","object":"HIGH","source":"cve","object_type":"enum","object_canonical":"high"},{"subject":"CVE-2026-84486","predicate":"date-published","object":"2026-09-23T18:35:50.890Z","source":"cve","object_type":"date","object_canonical":"2026-09-23t18:35:50.890z"},{"subject":"CVE-2026-84486","predicate":"date-updated","object":"2026-11-20T06:38:21.543Z","source":"cve","object_type":"date","object_canonical":"2026-11-20t06:38:21.543z"},{"subject":"CVE-2026-84486","predicate":"description","object":"A flaw was found in Red Hat Ansible Automation Platform's automation-\ncontroller. Four debug views that trigger the internal task, dependency, and\nworkflow schedulers are configured to allow any user (including unauthenticated\nclients) and are routed in production builds because their URL include is not\ngated on the debug setting. An unauthenticated remote attacker can repeatedly\ninvoke these endpoints to acquire the cluster-wide scheduler advisory lock;\nbecause the legitimate scheduler acquires the same lock without waiting, the\nattacker causes real scheduler runs to be skipped, stalling job dispatch for\nall tenants, while also consuming controller web workers. The debug root view\nadditionally discloses the list of debug endpoints to unauthenticated callers.","source":"cve","object_type":"string","object_canonical":"a flaw was found in red hat ansible automation platform's automation-\ncontroller. four debug views that trigger the internal task, dependency, and\nworkflow schedulers are configured to allow any user (including unauthenticated\nclients) and are routed in production builds because their url include is not\ngated on the debug setting. an unauthenticated remote attacker can repeatedly\ninvoke these endpoints to acquire the cluster-wide scheduler advisory lock;\nbecause the legitimate scheduler acquires the same lock without waiting, the\nattacker causes real scheduler runs to be skipped, stalling job dispatch for\nall tenants, while also consuming controller web workers. the debug root view\nadditionally discloses the list of debug endpoints to unauthenticated callers."},{"subject":"CVE-2026-84486","predicate":"product","object":"Red Hat Ansible Automation Platform 2.5 for RHEL 8","source":"cve","object_type":"string","object_canonical":"red hat ansible automation platform 2.5 for rhel 8"},{"subject":"CVE-2026-84486","predicate":"product","object":"Red Hat Ansible Automation Platform 2.5 for RHEL 9","source":"cve","object_type":"string","object_canonical":"red hat ansible automation platform 2.5 for rhel 9"},{"subject":"CVE-2026-84486","predicate":"product","object":"Red Hat Ansible Automation Platform 2.6 for RHEL 9","source":"cve","object_type":"string","object_canonical":"red hat ansible automation platform 2.6 for rhel 9"},{"subject":"CVE-2026-84486","predicate":"product","object":"Red Hat Ansible Automation Platform 2.6","source":"cve","object_type":"string","object_canonical":"red hat ansible automation platform 2.6"},{"subject":"CVE-2026-84486","predicate":"product","object":"Red Hat Ansible Automation Platform 2.7","source":"cve","object_type":"string","object_canonical":"red hat ansible automation platform 2.7"},{"subject":"CVE-2026-84486","predicate":"rdf:type","object":"Vulnerability","source":"cve","object_type":"enum","object_canonical":"vulnerability"},{"subject":"CVE-2026-84486","predicate":"related-weakness","object":"CWE-489","source":"cve","object_type":"id","object_canonical":"CWE-489"},{"subject":"CVE-2026-84486","predicate":"state","object":"PUBLISHED","source":"cve","object_type":"enum","object_canonical":"published"},{"subject":"CVE-2026-84486","predicate":"vendor","object":"Red Hat","source":"cve","object_type":"string","object_canonical":"red hat"},{"subject":"CVE-2026-84499","predicate":"affects-cpe","object":"cpe:/a:redhat:ansible_automation_platform:2.5::el8","source":"cve","object_type":"id","object_canonical":"cpe:/a:redhat:ansible_automation_platform:2.5::el8"},{"subject":"CVE-2026-84499","predicate":"affects-cpe","object":"cpe:/a:redhat:ansible_automation_platform:2.5::el9","source":"cve","object_type":"id","object_canonical":"cpe:/a:redhat:ansible_automation_platform:2.5::el9"},{"subject":"CVE-2026-84499","predicate":"affects-cpe","object":"cpe:/a:redhat:ansible_automation_platform_developer:2.5::el9","source":"cve","object_type":"id","object_canonical":"cpe:/a:redhat:ansible_automation_platform_developer:2.5::el9"},{"subject":"CVE-2026-84499","predicate":"affects-cpe","object":"cpe:/a:redhat:ansible_automation_platform_inside:2.5::el8","source":"cve","object_type":"id","object_canonical":"cpe:/a:redhat:ansible_automation_platform_inside:2.5::el8"},{"subject":"CVE-2026-84499","predicate":"affects-cpe","object":"cpe:/a:redhat:ansible_automation_platform_inside:2.5::el9","source":"cve","object_type":"id","object_canonical":"cpe:/a:redhat:ansible_automation_platform_inside:2.5::el9"},{"subject":"CVE-2026-84499","predi