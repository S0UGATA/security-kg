ject":"CVE-2026-84185","predicate":"assigner","object":"redhat","source":"cve","object_type":"string","object_canonical":"redhat"},{"subject":"CVE-2026-84185","predicate":"cvss-base-score","object":"5.9","source":"cve","object_type":"number","object_canonical":"5.9"},{"subject":"CVE-2026-84185","predicate":"cvss-severity","object":"MEDIUM","source":"cve","object_type":"enum","object_canonical":"medium"},{"subject":"CVE-2026-84185","predicate":"date-published","object":"2026-09-03T20:46:40.788Z","source":"cve","object_type":"date","object_canonical":"2026-09-03t20:46:40.788z"},{"subject":"CVE-2026-84185","predicate":"date-updated","object":"2026-09-04T18:57:22.299Z","source":"cve","object_type":"date","object_canonical":"2026-09-04t18:57:22.299z"},{"subject":"CVE-2026-84185","predicate":"description","object":"A flaw was found in the jwcrypto library, which is used for implementing Javascript Object Signing and Encryption (JOSE) standards. The issue occurs when the library verifies a General JSON Serialization JWS using a set of keys. Due to a coding error, the library fails to correctly identify the specific key ID (kid) and may instead accept a signature made by any valid key in the set. This can allow an attacker with a valid key to bypass authorization checks in applications that rely on the key ID to identify specific tenants or users.","source":"cve","object_type":"string","object_canonical":"a flaw was found in the jwcrypto library, which is used for implementing javascript object signing and encryption (jose) standards. the issue occurs when the library verifies a general json serialization jws using a set of keys. due to a coding error, the library fails to correctly identify the specific key id (kid) and may instead accept a signature made by any valid key in the set. this can allow an attacker with a valid key to bypass authorization checks in applications that rely on the key id to identify specific tenants or users."},{"subject":"CVE-2026-84185","predicate":"product","object":"Red Hat Ansible Automation Platform 2","source":"cve","object_type":"string","object_canonical":"red hat ansible automation platform 2"},{"subject":"CVE-2026-84185","predicate":"product","object":"Red Hat Enterprise Linux 10","source":"cve","object_type":"string","object_canonical":"red hat enterprise linux 10"},{"subject":"CVE-2026-84185","predicate":"product","object":"Red Hat Enterprise Linux 7","source":"cve","object_type":"string","object_canonical":"red hat enterprise linux 7"},{"subject":"CVE-2026-84185","predicate":"product","object":"Red Hat Enterprise Linux 8","source":"cve","object_type":"string","object_canonical":"red hat enterprise linux 8"},{"subject":"CVE-2026-84185","predicate":"product","object":"Red Hat Enterprise Linux 9","source":"cve","object_type":"string","object_canonical":"red hat enterprise linux 9"},{"subject":"CVE-2026-84185","predicate":"product","object":"Red Hat OpenShift AI (RHOAI)","source":"cve","object_type":"string","object_canonical":"red hat openshift ai (rhoai)"},{"subject":"CVE-2026-84185","predicate":"product","object":"Red Hat OpenStack Platform 16.2","source":"cve","object_type":"string","object_canonical":"red hat openstack platform 16.2"},{"subject":"CVE-2026-84185","predicate":"rdf:type","object":"Vulnerability","source":"cve","object_type":"enum","object_canonical":"vulnerability"},{"subject":"CVE-2026-84185","predicate":"related-weakness","object":"CWE-347","source":"cve","object_type":"id","object_canonical":"CWE-347"},{"subject":"CVE-2026-84185","predicate":"state","object":"PUBLISHED","source":"cve","object_type":"enum","object_canonical":"published"},{"subject":"CVE-2026-84185","predicate":"vendor","object":"Red Hat","source":"cve","object_type":"string","object_canonical":"red hat"},{"subject":"CVE-2026-84232","predicate":"affects-cpe","object":"cpe:/a:redhat:satellite:6","source":"cve","object_type":"id","object_canonical":"cpe:/a:redhat:satellite:6"},{"subject":"CVE-2026-84232","predicat