l":"cpe:/a:redhat:openshift:4.17::el9"},{"subject":"CVE-2024-45497","predicate":"affects-cpe","object":"cpe:/a:redhat:openshift:4.18::el9","source":"cve","object_type":"id","object_canonical":"cpe:/a:redhat:openshift:4.18::el9"},{"subject":"CVE-2024-45497","predicate":"affects-cpe","object":"cpe:/a:redhat:openshift:4.20::el9","source":"cve","object_type":"id","object_canonical":"cpe:/a:redhat:openshift:4.20::el9"},{"subject":"CVE-2024-45497","predicate":"affects-cpe","object":"cpe:/a:redhat:jboss_fuse:7","source":"cve","object_type":"id","object_canonical":"cpe:/a:redhat:jboss_fuse:7"},{"subject":"CVE-2024-45497","predicate":"assigner","object":"redhat","source":"cve","object_type":"string","object_canonical":"redhat"},{"subject":"CVE-2024-45497","predicate":"cvss-base-score","object":"7.6","source":"cve","object_type":"number","object_canonical":"7.6"},{"subject":"CVE-2024-45497","predicate":"cvss-severity","object":"HIGH","source":"cve","object_type":"enum","object_canonical":"high"},{"subject":"CVE-2024-45497","predicate":"date-published","object":"2024-12-31T02:19:22.553Z","source":"cve","object_type":"date","object_canonical":"2024-12-31t02:19:22.553z"},{"subject":"CVE-2024-45497","predicate":"date-updated","object":"2026-09-21T17:11:18.064Z","source":"cve","object_type":"date","object_canonical":"2026-09-21t17:11:18.064z"},{"subject":"CVE-2024-45497","predicate":"description","object":"A flaw was found in the OpenShift build process, where the docker-build container is configured with a hostPath volume mount that maps the node's /var/lib/kubelet/config.json file into the build pod. This file contains sensitive credentials necessary for pulling images from private repositories. The mount is not read-only, which allows the attacker to overwrite it. By modifying the config.json file, the attacker can cause a denial of service by preventing the node from pulling new images and potentially exfiltrating sensitive secrets. This flaw impacts the availability of services dependent on image pulls and exposes sensitive information to unauthorized parties.","source":"cve","object_type":"string","object_canonical":"a flaw was found in the openshift build process, where the docker-build container is configured with a hostpath volume mount that maps the node's /var/lib/kubelet/config.json file into the build pod. this file contains sensitive credentials necessary for pulling images from private repositories. the mount is not read-only, which allows the attacker to overwrite it. by modifying the config.json file, the attacker can cause a denial of service by preventing the node from pulling new images and potentially exfiltrating sensitive secrets. this flaw impacts the availability of services dependent on image pulls and exposes sensitive information to unauthorized parties."},{"subject":"CVE-2024-45497","predicate":"product","object":"Red Hat OpenShift Container Platform 4.12","source":"cve","object_type":"string","object_canonical":"red hat openshift container platform 4.12"},{"subject":"CVE-2024-45497","predicate":"product","object":"Red Hat OpenShift Container Platform 4.13","source":"cve","object_type":"string","object_canonical":"red hat openshift container platform 4.13"},{"subject":"CVE-2024-45497","predicate":"product","object":"Red Hat OpenShift Container Platform 4.14","source":"cve","object_type":"string","object_canonical":"red hat openshift container platform 4.14"},{"subject":"CVE-2024-45497","predicate":"product","object":"Red Hat OpenShift Container Platform 4.16","source":"cve","object_type":"string","object_canonical":"red hat openshift container platform 4.16"},{"subject":"CVE-2024-45497","predicate":"product","object":"Red Hat OpenShift Container Platform 4.17","source":"cve","object_type":"string","object_canonical":"red hat openshift container platform 4.17"},{"subject":"CVE-2024-45497","predicate":"product","object":"Red Hat OpenShift Container Platform 4.18","source":"cve","object_type":"string","object_canonical":"red hat openshift container platform 4.18"},{"subject":"CVE-2024-45497","predicate":"product","object":"Red Hat OpenShift Container Platform 4.19","source":"cve","object_type":"string","object_canonical":"red hat openshift container platform 4.19"}]